# ──────────────────────────────────────────────
# Embeddable Widget & Lead-Capture Platform
# ──────────────────────────────────────────────

# ─── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://widget_user:widget_pass@localhost:5432/widget_platform
DATABASE_URL_SYNC=postgresql://widget_user:widget_pass@localhost:5432/widget_platform

# ─── Auth ─────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Geo Enrichment Providers ────────────────
GEO_PROVIDER_A_URL=http://ip-api.com/json/
GEO_PROVIDER_B_URL=https://ipapi.co/
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true

# ─── Email / Side Effect ─────────────────────
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@widget-platform.local

# ─── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# ─── App ──────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
WIDGET_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=*
